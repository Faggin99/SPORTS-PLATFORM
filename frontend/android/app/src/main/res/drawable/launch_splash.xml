<?xml version="1.0" encoding="utf-8"?>
<!-- Splash sem escala de bitmap: fundo navy sólido + logo vetorial centralizado
     em tamanho FIXO (dp). Nunca estica nem borra — substitui o splash.png que
     o windowBackground esticava pra preencher a janela. Usado no fallback
     Android <12 e pelo plugin SplashScreen do Capacitor. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splashBackground"/>
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="center"
        android:drawable="@drawable/splash_icon"/>
</layer-list>
